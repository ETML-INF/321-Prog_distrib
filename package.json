{
  "siteBase": "/321-Prog_distrib/",
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "cytoscape": "^3.34.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "glob": "^11.1.0",
    "markdown-it": "^14.3.3",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^12.2.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.44"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "docs:check": "node scripts/check-anchors.mjs && bash scripts/check-core-agnostic.sh",
    "slidev:lin": "BASE=$(node -p \"require('./package.json').siteBase\") && for f in slides/*.md; do slidev build \"${f}\" --out \"../.vitepress/dist/slides/$(basename \"${f}\" .md)\" --base \"${BASE}slides/$(basename \"${f}\" .md)/\" ; done",
    "slidev:win": "for /f \"delims=\" %B in ('node -p \"require('./package.json').siteBase\"') do @for %%F in (slides\\*.md) do slidev build \"%%F\" --out \"..\\.vitepress\\dist\\slides\\%%~nF\" --base \"%Bslides/%%~nF/\""
  },
  "packageManager": "pnpm@9.11.0+sha512.0a203ffaed5a3f63242cd064c8fb5892366c103e328079318f78062f24ea8c9d50bc6a47aa3567cabefd824d170e78fa2745ed1f16b132e16436146b7688f19b",
  "pnpm": {
    "overrides": {
      "markdown-it": "^14.3.3",
      "vite": ">=6.4.4",
      "vitepress>vite": "^6.4.4"
    }
  }
}
